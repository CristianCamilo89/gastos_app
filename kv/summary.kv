#:import hex kivy.utils.get_color_from_hex
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<SummaryScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(16)
        spacing: dp(10)
        canvas.before:
            Color:
                rgba: hex('#F4F6FA')
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)
            Button:
                text: '<'
                size_hint_x: None
                width: dp(48)
                on_release: root.change_month(-1)
            Label:
                text: root.month_text
                bold: True
                font_size: sp(18)
            Button:
                text: '>'
                size_hint_x: None
                width: dp(48)
                on_release: root.change_month(1)

        Label:
            text: root.total_text
            size_hint_y: None
            height: dp(28)

        # Aquí se inserta la gráfica (imagen de matplotlib o barras nativas)
        BoxLayout:
            id: chart_box
            orientation: 'vertical'

        Button:
            text: 'Exportar a CSV'
            bold: True
            size_hint_y: None
            height: dp(52)
            on_release: root.export()
