#:import hex kivy.utils.get_color_from_hex
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<AddTransactionScreen>:
    ScrollView:
        do_scroll_x: False
        canvas.before:
            Color:
                rgba: hex('#F4F6FA')
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            orientation: 'vertical'
            padding: dp(16)
            spacing: dp(10)
            size_hint_y: None
            height: self.minimum_height

            Label:
                text: root.title_text
                bold: True
                font_size: sp(22)
                size_hint_y: None
                height: dp(44)
            Spinner:
                id: kind
                text: 'Gasto'
                values: root.kinds
                size_hint_y: None
                height: dp(48)
            TextInput:
                id: description
                hint_text: 'Descripción'
                multiline: False
                size_hint_y: None
                height: dp(48)
            TextInput:
                id: amount
                hint_text: 'Monto'
                input_filter: 'float'
                multiline: False
                size_hint_y: None
                height: dp(48)
            Spinner:
                id: category
                text: 'Comida'
                values: root.categories
                size_hint_y: None
                height: dp(48)
            TextInput:
                id: date
                hint_text: 'Fecha (AAAA-MM-DD)'
                multiline: False
                size_hint_y: None
                height: dp(48)
            Spinner:
                id: method
                text: 'Efectivo'
                values: root.methods
                size_hint_y: None
                height: dp(48)
            Button:
                text: 'Guardar'
                bold: True
                size_hint_y: None
                height: dp(52)
                on_release: root.save()
